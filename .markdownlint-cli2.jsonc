{
  // Single source of truth for markdown linting.
  //
  // Local, CI and the ACE verify gate all invoke the same bare command:
  //     npx markdownlint-cli2
  // Globs and rules live here so those three can never drift apart.
  "globs": ["**/*.md"],

  // Third-party packs retain upstream formatting. First-party packs are linted.
  // NotebookLM bundles concatenate complete documents; lint their sources instead.
  "ignores": [".ace/packs/scientific/**", ".ace/packs/ai-research/**", "ace_notebooklm_export_part*.md", "**/node_modules/**"],

  "config": {
    "default": true,

    "MD013": false,
    "MD033": false,
    "MD041": false,

    // MD060 autofix strips table padding, so every table in the docs stops
    // being aligned in the source while rendering identically.
    "MD060": false,

    "MD024": { "siblings_only": true }
  }
}
